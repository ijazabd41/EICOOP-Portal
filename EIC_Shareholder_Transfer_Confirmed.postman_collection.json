      "name": "01 - Recipient Lookup",
      "item": [
        {
          "name": "Lookup recipient 6776",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "session_id={{session_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"membership_no\": \"{{recipient_membership_no}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/shareholder/transfer/lookup_recipient",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "shareholder",
                "transfer",
                "lookup_recipient"
              ]
            },
            "description": "Validate recipient 6776 before transfer."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response is JSON\", function () { pm.response.to.be.json; });",
                  "const data = pm.response.json();",
                  "pm.test(\"Response has success\", function () { pm.expect(data).to.have.property(\"success\"); });",
                  "const ok = data.success === true || data.success === 1 || data.success === \"true\";",
                  "pm.test(\"Success is true\", function () { pm.expect(ok).to.eql(true); });"
                ]
              }
            }
          ]
        },
